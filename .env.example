NODE_ENV=development
PORT=3000
DATABASE_URL=
SESSION_SECRET=
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Phase 5 — Gemini AI processing (server-side only; never exposed to the web app).
# "duyanh" is a placeholder: replace it with the real Gemini API key in your local .env.
GEMINI_API_KEY=duyanh
# Optional overrides (defaults shown).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
AI_CANDIDATE_WINDOW_HOURS=72
AI_MAX_CANDIDATES=8

# Phase 6 — Daily Digest email (server-side only; never exposed to the web app).
# Resend is the only supported provider. "duyanhapikeyresend" is a placeholder:
# put the real Resend API key only in your local .env (EMAIL_API_KEY is accepted as an alias).
# The recipient is NOT configured here: it is user_settings.recipient_email (Settings page).
EMAIL_PROVIDER=resend
RESEND_API_KEY=duyanhapikeyresend
EMAIL_FROM=news@buiduyanh.io.vn
# Optional: Resend webhook signing secret (whsec_...) to record delivered/bounced events.
RESEND_WEBHOOK_SECRET=
EMAIL_TIMEOUT_MS=15000
# Set to false to run the server without the 05:30/06:00/06:30/06:45 JST digest schedule.
# Production (Render Free): false — Cron-job.org is the scheduler (docs/deployment.md).
DIGEST_SCHEDULER_ENABLED=true

# Phase 9 — production (placeholders only; real values live in Render's environment).
# Cron-job.org trigger: POST /api/v1/internal/cron/daily-digest with "Authorization: Bearer <token>".
# At least 32 characters (e.g. `openssl rand -hex 32`); unset = endpoint disabled (404). Server-side only.
CRON_TRIGGER_TOKEN=
# Optional: max connections of the application PostgreSQL pool (default 10).
DATABASE_POOL_MAX=10
# Production notes: NODE_ENV=production requires PORT (Render provides it) and an exact
# https CORS_ORIGIN (https://digest.buiduyanh.io.vn). DATABASE_URL = Neon direct connection
# string with sslmode=require. ADMIN_EMAIL/ADMIN_PASSWORD are only for one-time admin:create.
