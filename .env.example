# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=

# Authentication
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS
# Local development:
CORS_ORIGIN=http://localhost:5173

# Gemini AI
# Server-side only. Never expose this key to the web application.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# AI processing
AI_CANDIDATE_WINDOW_HOURS=72
AI_MAX_CANDIDATES=8

# Email
# Supported provider: resend
EMAIL_PROVIDER=resend

# Server-side only. Create your own Resend API key.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TIMEOUT_MS=15000

# Optional Resend webhook signing secret.
# Example format: whsec_...
RESEND_WEBHOOK_SECRET=

# Daily Digest
# Local development can use the internal scheduler.
# Production on Render Free should keep this false and use cron-job.org.
DIGEST_SCHEDULER_ENABLED=true

# Cron trigger
# Used by cron-job.org:
# POST /api/v1/internal/cron/daily-digest
# Header: Authorization: Bearer <CRON_TRIGGER_TOKEN>
CRON_TRIGGER_TOKEN=

# PostgreSQL connection pool
# Default: 10
DATABASE_POOL_MAX=10

# Production notes:
# - NODE_ENV=production
# - Render provides PORT automatically; do not hard-code it.
# - CORS_ORIGIN must be the exact HTTPS production URL.
# - DATABASE_URL should point to your production PostgreSQL database.
# - SESSION_SECRET and CRON_TRIGGER_TOKEN must be strong random values.
# - ADMIN_EMAIL and ADMIN_PASSWORD are used for one-time admin creation.
#
# Do not commit the real .env file or any API keys/passwords to Git.
