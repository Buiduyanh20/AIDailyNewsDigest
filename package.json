{
  "name": "ai-daily-news-digest",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @aidnd/web --filter @aidnd/server dev",
    "build": "corepack pnpm --recursive --workspace-concurrency=1 --if-present build",
    "test": "corepack pnpm --recursive --if-present test",
    "lint": "corepack pnpm --recursive --if-present lint",
    "typecheck": "corepack pnpm --recursive --if-present build && corepack pnpm --recursive --if-present typecheck",
    "format": "corepack pnpm --recursive --if-present format",
    "admin:create": "corepack pnpm --filter @aidnd/server admin:create"
  }
}
