# Allowlist: the build context contains only what the Dockerfile needs.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!.figma/make/site.json
!apps/server/package.json
!apps/server/tsconfig.json
!apps/server/src/
!apps/server/migrations/
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/index.html
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/public/
!packages/domain/package.json
!packages/domain/tsconfig.json
!packages/domain/src/
!packages/contracts/package.json
!packages/contracts/tsconfig.json
!packages/contracts/src/

# Never send these, even inside allowlisted folders.
**/.git
**/.env
**/.env.*
**/node_modules
**/dist
**/coverage
**/*.log
**/cookies*.txt
**/headers*.txt
**/*.tsbuildinfo
