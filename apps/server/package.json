{
  "name": "@aidnd/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/app.test.ts src/db/foundation.integration.test.ts src/errors/errors.test.ts src/db/dates.test.ts src/ai/ai.test.ts src/ai/eval/ai-quality.test.ts src/events/events.integration.test.ts src/digest/digest.test.ts src/digest/digest.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "admin:create": "tsx src/admin/create-admin.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "ai:smoke": "tsx src/ai/smoke-cli.ts",
    "ai:requeue": "tsx src/ai/requeue-cli.ts",
    "ai:eval": "tsx src/ai/eval/run-cli.ts",
    "articles:backfill-language": "tsx src/sources/language-backfill-cli.ts",
    "digest:run": "tsx src/digest/run-cli.ts"
  },
  "dependencies": {
    "@aidnd/contracts": "workspace:*",
    "@aidnd/domain": "workspace:*",
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.10",
    "argon2": "^0.41.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "pg": "^8.14.1",
    "pg-boss": "^10.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  }
}
